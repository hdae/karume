{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": ["node", "@webgpu/types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/*/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "tools/lang/**/*.ts",
    "tools/lint/**/*.ts",
    "tools/published-smoke/**/*.ts",
    "tools/verify-diff/**/*.ts",
    "tools/release/**/*.ts",
    "tools/test-assets/**/*.ts",
    "vite.config.ts"
  ]
}
