{
  "workspace": ["./packages/runtime", "./packages/hub", "./packages/models"],
  "exclude": ["inputs/", "outputs/", "models/"],
  "minimumDependencyAge": {
    "exclude": ["jsr:@hdae/*"]
  },
  "tasks": {
    "check": "deno check packages/runtime/mod.ts packages/hub/mod.ts packages/hub/deno.ts packages/models/mod.ts examples/anima/main.ts examples/anima/eval-images.ts examples/sbv2/main.ts examples/sbv2/dump.ts examples/irodori/main.ts examples/irodori/eval-audio.ts examples/vowel-detector/main.ts",
    "verify": "deno fmt --check && deno lint && deno task check && deno test -A",
    "demo:anima": "deno run -A examples/anima/main.ts",
    "demo:eval-audio": "deno run -A examples/irodori/eval-audio.ts",
    "demo:eval-images": "deno run -A examples/anima/eval-images.ts",
    "demo:irodori": "deno run -A examples/irodori/main.ts",
    "demo:sbv2": "deno run -A examples/sbv2/main.ts",
    "demo:vowel-detector": "deno run -A examples/vowel-detector/main.ts",
    "dump:sbv2": "deno run -A examples/sbv2/dump.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@hdae/yomi": "jsr:@hdae/yomi@^0.4.2",
    "@hdae/yomi/loader": "jsr:@hdae/yomi@^0.4.2/loader"
  }
}
