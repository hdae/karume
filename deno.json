{
  "workspace": ["./packages/runtime", "./packages/hub", "./packages/models"],
  "exclude": ["inputs/", "outputs/", "models/", ".claude/reviews/"],
  "minimumDependencyAge": {
    "exclude": ["jsr:@hdae/*"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@hdae/yomi": "jsr:@hdae/yomi@^0.4.2",
    "@hdae/yomi/loader": "jsr:@hdae/yomi@^0.4.2/loader",
    "@std/testing/bdd": "jsr:@std/testing@1/bdd",
    "fast-png": "npm:fast-png@^8.0.0",
    "jpeg-js": "npm:jpeg-js@^0.4.4"
  },
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
