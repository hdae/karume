  "eval": [
    { "expr": "T", "bindings": { "T": 5 }, "value": 5 },
    { "expr": "T", "bindings": { "T": 0 }, "value": 0 },
    { "expr": "8T", "bindings": { "T": 5 }, "value": 40 },
    { "expr": "T+8", "bindings": { "T": 5 }, "value": 13 },
    { "expr": "8T+2", "bindings": { "T": 3 }, "value": 26 },
    { "expr": "16H+15", "bindings": { "H": 0, "T": 7 }, "value": 15 },
    {
      "expr": "T",
      "bindings": { "S": 5 },
      "throws": true,
      "why": "an unbound symbol is not passed silently"
    },
    {
      "expr": "toString",
      "bindings": {},
      "throws": true,
      "why": "keys from Object.prototype are not bindings (presence is checked by the equivalent of hasOwn only)"
    },
    {
      "expr": "constructor",
      "bindings": {},
      "throws": true,
      "why": "same as above (closes the path where prototype pollution silently turns the arithmetic into NaN)"
    },
    {
      "expr": "valueOf",
      "bindings": {},
      "throws": true,
      "why": "same as above"
    },
    {
      "expr": "hasOwnProperty",
      "bindings": {},
      "throws": true,
      "why": "same as above"
    },
    {
      "expr": "toString",
      "bindings": { "toString": 4 },
      "value": 4,
      "why": "passes when it exists as an own binding (the name itself is not a forbidden word)"
    },
    {
      "expr": "T",
      "bindings": { "T": -1 },
      "throws": true,
      "why": "dimensions are non-negative"
    },
    {
      "expr": "T",
      "bindings": { "T": 1.5 },
      "throws": true,
      "why": "dimensions are integers"
    }
  ]
