    "",
    " ",
    " T",
    "T ",
    "2 T",
    "-T",
    "-1T",
    "T-1",
    "T+-1",
    "T+U",
    "2T+3U",
    "TU2+T",
    "T*2",
    "2*T",
    "8+T",
    "T++1",
