    acc3 = acc3 + xa0_0_3.y * d0_0_y;
    acc3 = acc3 + xa0_0_3.z * d0_0_z;
    acc3 = acc3 + xa0_0_3.w * d0_0_w;
    let b0_1 = unpack4xI8(pw0.y);
    let d0_1_x = f32(b0_1.x) * wscale_v;
    let d0_1_y = f32(b0_1.y) * wscale_v;
    let d0_1_z = f32(b0_1.z) * wscale_v;
    let d0_1_w = f32(b0_1.w) * wscale_v;
    let xa0_1_0 = x[xr0 + xq0 + 1u];
    acc0 = acc0 + xa0_1_0.x * d0_1_x;
    acc0 = acc0 + xa0_1_0.y * d0_1_y;
    acc0 = acc0 + xa0_1_0.z * d0_1_z;
    acc0 = acc0 + xa0_1_0.w * d0_1_w;
