  if (row0 + 0u < dims.m) {
    out[(row0 + 0u) * dims.n + col] = acc0 + bias[col];
  }
  if (row0 + 1u < dims.m) {
    out[(row0 + 1u) * dims.n + col] = acc1 + bias[col];
  }
  if (row0 + 2u < dims.m) {
    out[(row0 + 2u) * dims.n + col] = acc2 + bias[col];
