    acc3 = acc3 + xa0_1_3.y * d0_1_y;
    acc3 = acc3 + xa0_1_3.z * d0_1_z;
    acc3 = acc3 + xa0_1_3.w * d0_1_w;
    let b0_2 = unpack4xI8(pw0.z);
    let d0_2_x = f32(b0_2.x) * wscale_v;
