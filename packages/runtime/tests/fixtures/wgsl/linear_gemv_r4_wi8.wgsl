    acc1 = acc1 + xa0_1_1.y * d0_1_y;
    acc1 = acc1 + xa0_1_1.z * d0_1_z;
    acc1 = acc1 + xa0_1_1.w * d0_1_w;
    let xa0_1_2 = x[xr2 + xq0 + 1u];
    acc2 = acc2 + xa0_1_2.x * d0_1_x;
    acc2 = acc2 + xa0_1_2.y * d0_1_y;
    acc2 = acc2 + xa0_1_2.z * d0_1_z;
    acc2 = acc2 + xa0_1_2.w * d0_1_w;
    let xa0_1_3 = x[xr3 + xq0 + 1u];
