    let xa3_1_3 = x[xr3 + xq3 + 1u];
    acc3 = acc3 + xa3_1_3.x * d3_1_x;
    acc3 = acc3 + xa3_1_3.y * d3_1_y;
    acc3 = acc3 + xa3_1_3.z * d3_1_z;
    acc3 = acc3 + xa3_1_3.w * d3_1_w;
    let b3_2 = unpack4xI8(pw3.z);
    let d3_2_x = f32(b3_2.x) * wscale_v;
    let d3_2_y = f32(b3_2.y) * wscale_v;
    let d3_2_z = f32(b3_2.z) * wscale_v;
    let d3_2_w = f32(b3_2.w) * wscale_v;
    let xa3_2_0 = x[xr0 + xq3 + 2u];
    acc0 = acc0 + xa3_2_0.x * d3_2_x;
    acc0 = acc0 + xa3_2_0.y * d3_2_y;
    acc0 = acc0 + xa3_2_0.z * d3_2_z;
    acc0 = acc0 + xa3_2_0.w * d3_2_w;
    let xa3_2_1 = x[xr1 + xq3 + 2u];
    acc1 = acc1 + xa3_2_1.x * d3_2_x;
    acc1 = acc1 + xa3_2_1.y * d3_2_y;
    acc1 = acc1 + xa3_2_1.z * d3_2_z;
    acc1 = acc1 + xa3_2_1.w * d3_2_w;
    let xa3_2_2 = x[xr2 + xq3 + 2u];
    acc2 = acc2 + xa3_2_2.x * d3_2_x;
