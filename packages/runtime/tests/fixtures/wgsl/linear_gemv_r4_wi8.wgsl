    acc3 = acc3 + xat_1_3.y * dt_1_y;
    acc3 = acc3 + xat_1_3.z * dt_1_z;
    acc3 = acc3 + xat_1_3.w * dt_1_w;
    let bt_2 = unpack4xI8(pwt.z);
    let dt_2_x = f32(bt_2.x) * wscale_v;
    let dt_2_y = f32(bt_2.y) * wscale_v;
    let dt_2_z = f32(bt_2.z) * wscale_v;
    let dt_2_w = f32(bt_2.w) * wscale_v;
    let xat_2_0 = x[xr0 + xqt + 2u];
    acc0 = acc0 + xat_2_0.x * dt_2_x;
    acc0 = acc0 + xat_2_0.y * dt_2_y;
    acc0 = acc0 + xat_2_0.z * dt_2_z;
    acc0 = acc0 + xat_2_0.w * dt_2_w;
    let xat_2_1 = x[xr1 + xqt + 2u];
    acc1 = acc1 + xat_2_1.x * dt_2_x;
    acc1 = acc1 + xat_2_1.y * dt_2_y;
    acc1 = acc1 + xat_2_1.z * dt_2_z;
    acc1 = acc1 + xat_2_1.w * dt_2_w;
    let xat_2_2 = x[xr2 + xqt + 2u];
    acc2 = acc2 + xat_2_2.x * dt_2_x;
    acc2 = acc2 + xat_2_2.y * dt_2_y;
    acc2 = acc2 + xat_2_2.z * dt_2_z;
    acc2 = acc2 + xat_2_2.w * dt_2_w;
    let xat_2_3 = x[xr3 + xqt + 2u];
    acc3 = acc3 + xat_2_3.x * dt_2_x;
    acc3 = acc3 + xat_2_3.y * dt_2_y;
    acc3 = acc3 + xat_2_3.z * dt_2_z;
    acc3 = acc3 + xat_2_3.w * dt_2_w;
    let bt_3 = unpack4xI8(pwt.w);
    let dt_3_x = f32(bt_3.x) * wscale_v;
    let dt_3_y = f32(bt_3.y) * wscale_v;
    let dt_3_z = f32(bt_3.z) * wscale_v;
    let dt_3_w = f32(bt_3.w) * wscale_v;
    let xat_3_0 = x[xr0 + xqt + 3u];
