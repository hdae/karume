    let xa3_0_3 = x[xr3 + xq3 + 0u];
    acc3 = acc3 + xa3_0_3.x * d3_0_x;
    acc3 = acc3 + xa3_0_3.y * d3_0_y;
    acc3 = acc3 + xa3_0_3.z * d3_0_z;
    acc3 = acc3 + xa3_0_3.w * d3_0_w;
    let b3_1 = unpack4xI8(pw3.y);
    let d3_1_x = f32(b3_1.x) * wscale_v;
    let d3_1_y = f32(b3_1.y) * wscale_v;
    let d3_1_z = f32(b3_1.z) * wscale_v;
    let d3_1_w = f32(b3_1.w) * wscale_v;
    let xa3_1_0 = x[xr0 + xq3 + 1u];
    acc0 = acc0 + xa3_1_0.x * d3_1_x;
    acc0 = acc0 + xa3_1_0.y * d3_1_y;
    acc0 = acc0 + xa3_1_0.z * d3_1_z;
    acc0 = acc0 + xa3_1_0.w * d3_1_w;
    let xa3_1_1 = x[xr1 + xq3 + 1u];
    acc1 = acc1 + xa3_1_1.x * d3_1_x;
    acc1 = acc1 + xa3_1_1.y * d3_1_y;
    acc1 = acc1 + xa3_1_1.z * d3_1_z;
    acc1 = acc1 + xa3_1_1.w * d3_1_w;
    let xa3_1_2 = x[xr2 + xq3 + 1u];
    acc2 = acc2 + xa3_1_2.x * d3_1_x;
    acc2 = acc2 + xa3_1_2.y * d3_1_y;
