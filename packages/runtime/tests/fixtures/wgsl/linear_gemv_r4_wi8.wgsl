    let xa3_3_3 = x[xr3 + xq3 + 3u];
    acc3 = acc3 + xa3_3_3.x * d3_3_x;
    acc3 = acc3 + xa3_3_3.y * d3_3_y;
    acc3 = acc3 + xa3_3_3.z * d3_3_z;
    acc3 = acc3 + xa3_3_3.w * d3_3_w;
  }
  // 端数の語（units % 4 本）— 上と同じ順序を 1 語ずつ辿る
  for (; unit < units; unit = unit + 1u) {
    let unitt = unit;
    let pwt = w[row_base + unitt];
    let xqt = unitt * 4u;
    let bt_0 = unpack4xI8(pwt.x);
    let dt_0_x = f32(bt_0.x) * wscale_v;
    let dt_0_y = f32(bt_0.y) * wscale_v;
    let dt_0_z = f32(bt_0.z) * wscale_v;
    let dt_0_w = f32(bt_0.w) * wscale_v;
    let xat_0_0 = x[xr0 + xqt + 0u];
    acc0 = acc0 + xat_0_0.x * dt_0_x;
    acc0 = acc0 + xat_0_0.y * dt_0_y;
    acc0 = acc0 + xat_0_0.z * dt_0_z;
    acc0 = acc0 + xat_0_0.w * dt_0_w;
    let xat_0_1 = x[xr1 + xqt + 0u];
    acc1 = acc1 + xat_0_1.x * dt_0_x;
    acc1 = acc1 + xat_0_1.y * dt_0_y;
    acc1 = acc1 + xat_0_1.z * dt_0_z;
    acc1 = acc1 + xat_0_1.w * dt_0_w;
    let xat_0_2 = x[xr2 + xqt + 0u];
    acc2 = acc2 + xat_0_2.x * dt_0_x;
    acc2 = acc2 + xat_0_2.y * dt_0_y;
    acc2 = acc2 + xat_0_2.z * dt_0_z;
    acc2 = acc2 + xat_0_2.w * dt_0_w;
    let xat_0_3 = x[xr3 + xqt + 0u];
    acc3 = acc3 + xat_0_3.x * dt_0_x;
    acc3 = acc3 + xat_0_3.y * dt_0_y;
    acc3 = acc3 + xat_0_3.z * dt_0_z;
    acc3 = acc3 + xat_0_3.w * dt_0_w;
    let bt_1 = unpack4xI8(pwt.y);
    let dt_1_x = f32(bt_1.x) * wscale_v;
    let dt_1_y = f32(bt_1.y) * wscale_v;
    let dt_1_z = f32(bt_1.z) * wscale_v;
    let dt_1_w = f32(bt_1.w) * wscale_v;
    let xat_1_0 = x[xr0 + xqt + 1u];
    acc0 = acc0 + xat_1_0.x * dt_1_x;
    acc0 = acc0 + xat_1_0.y * dt_1_y;
    acc0 = acc0 + xat_1_0.z * dt_1_z;
    acc0 = acc0 + xat_1_0.w * dt_1_w;
    let xat_1_1 = x[xr1 + xqt + 1u];
    acc1 = acc1 + xat_1_1.x * dt_1_x;
    acc1 = acc1 + xat_1_1.y * dt_1_y;
    acc1 = acc1 + xat_1_1.z * dt_1_z;
    acc1 = acc1 + xat_1_1.w * dt_1_w;
    let xat_1_2 = x[xr2 + xqt + 1u];
